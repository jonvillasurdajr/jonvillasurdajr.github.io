---
layout: null
permalink: /sitemap.xml
---
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
  {% assign sitemap_pages = site.pages | where: "layout", "default" | sort: "url" %}
  {% for sitemap_page in sitemap_pages %}
  <url>
    <loc>{{ sitemap_page.url | absolute_url }}</loc>
    {% if sitemap_page.last_modified_at %}<lastmod>{{ sitemap_page.last_modified_at | date: "%Y-%m-%d" }}</lastmod>{% endif %}
  </url>
  {% endfor %}
</urlset>
